# Modu Brain local development configuration.
# Copy this file to .env and replace placeholders. Never commit .env.

# Supabase project settings used by the Node API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Never use a VITE_ prefix or expose this value to the browser.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Legacy JWT keys remain supported for local Supabase CLI environments.
# SUPABASE_ANON_KEY=your-legacy-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Browser Auth settings. The anon key is intentionally public and protected by RLS.
# These values usually match SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Optional same-origin collector for privacy-safe product events. Raw records,
# project titles, email addresses, and analysis output are never included.
VITE_PRODUCT_ANALYTICS_ENDPOINT=/api/v1/telemetry

# The deterministic local provider is the safe default.
MODU_BRAIN_ANALYSIS_PROVIDER=local-heuristic
MODU_BRAIN_OPENAI_ENABLED=false
MODU_BRAIN_OPENAI_MODEL=gpt-5.6-terra
MODU_BRAIN_OPENAI_REASONING_EFFORT=low

# Required only when a signed-in user explicitly chooses the OpenAI provider.
# Confirm that the configured account can access the selected preview model.
OPENAI_API_KEY=
SAFETY_IDENTIFIER_SECRET=replace-with-a-random-server-only-secret
IP_HASH_SECRET=replace-with-a-different-random-server-only-secret

# Runtime safety defaults. Keep OpenAI disabled on the free public demo.
MODU_BRAIN_REQUEST_DEADLINE_MS=45000
MODU_BRAIN_PUBLIC_REQUEST_TIMEOUT_MS=45000
MODU_BRAIN_OPENAI_TIMEOUT_MS=30000
MODU_BRAIN_READINESS_SUCCESS_TTL_MS=15000
MODU_BRAIN_READINESS_FAILURE_TTL_MS=3000
MODU_BRAIN_OPENAI_MAX_RETRIES=0
MODU_BRAIN_OPENAI_MAX_OUTPUT_TOKENS=6000
# Production must never use the process-local limiter. It is available only for
# an explicit offline development session with no Supabase.
MODU_BRAIN_ALLOW_IN_MEMORY_PUBLIC_LIMITER=false
MODU_BRAIN_TRUST_PROXY=direct

# Optional CAPTCHA token support for Supabase Auth. Cloudflare Turnstile can be
# configured without a paid plan; leave blank until a site key is provisioned.
# VITE_SUPABASE_CAPTCHA_SITE_KEY=

# The local server defaults to 127.0.0.1:4173. Render supplies PORT and requires
# HOST=0.0.0.0, which is already declared in render.yaml.
HOST=127.0.0.1
PORT=4173

# Optional Playwright integration-test settings. Use a dedicated Supabase project.
# E2E_BASE_URL=http://127.0.0.1:4173
# E2E_TEST_EMAIL=modu-brain-e2e@example.com
# E2E_SKIP_LOGIN_EMAIL_SEND=true # Hosted projects with a provider email-rate limit.
